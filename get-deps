#!/bin/sh
# This fork builds only on macOS. The build has no system package
# dependencies beyond the Xcode command line tools and Rust.

for arg in "$@"; do
    case $arg in
      --testing|--docs)
      ;;
      *)
        echo 'get-deps:'
        echo '  --docs       include dependencies required for testing docs'
        echo '  --testing    include dependencies required for tests'
        exit 1
      ;;
    esac
done

case "$(uname -s)" in
  Darwin)
  ;;
  *)
    echo "get-deps: this fork only supports macOS"
    exit 1
  ;;
esac

if ! xcode-select -p >/dev/null 2>&1; then
  echo "The Xcode command line tools are not installed."
  echo "Run: xcode-select --install"
  exit 1
fi

if ! command -v rustc >/dev/null; then
  echo "Rust is not installed!"
  echo "Please see https://wezterm.org/install/source.html for installation instructions"
  exit 1
fi
